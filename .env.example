# Backend (set these in the backend host environment settings)
PORT=5000
MONGO_URI=mongodb+srv://<database-user>:<encoded-password>@<cluster-host>/ecommerce?retryWrites=true&w=majority
JWT_SECRET=<generate-a-unique-random-secret-at-least-32-characters>
CLIENT_URL=https://<your-frontend-domain>

# Frontend build environment (set this in the frontend host settings)
VITE_API_URL=https://<your-backend-domain>
